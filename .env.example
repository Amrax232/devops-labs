# Скопируйте файл в .env и при необходимости измените значения.
# Реальный .env в репозиторий не попадает (см. .gitignore).

APP_NAME=warehouse-inventory
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
SQL_ECHO=false

# Учётная запись для доступа к API. В рабочей среде обязательно заменить.
AUTH_USERNAME=admin
AUTH_PASSWORD=warehouse123

# Подключение к базе для запуска из .venv (make run, make migrate) — через порт,
# который открывает make dev-db. Контейнеры приложения эту строку не используют:
# docker-compose.yml собирает её сам с адресом db:5432 во внутренней сети.
DATABASE_URL=postgresql+psycopg2://warehouse:warehouse@localhost:5432/warehouse

# Параметры контейнера PostgreSQL (docker compose)
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse
POSTGRES_DB=warehouse
# порт на 127.0.0.1 только для make dev-db (в основном окружении порта БД нет)
POSTGRES_PORT=5432

# Контейнерное окружение (make up): единственная точка входа — Nginx
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# тег образа приложения warehouse-inventory:<версия>
APP_VERSION=0.7.0

# Отдельная база для интеграционных тестов (make test-integration).
# Имя обязано оканчиваться на «_test»: тесты стирают её содержимое.
TEST_DATABASE_URL=postgresql+psycopg2://warehouse:warehouse@localhost:5432/warehouse_test
