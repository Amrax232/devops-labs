# Скопируйте файл в .env и при необходимости измените значения.
# Реальный .env в репозиторий не попадает (см. .gitignore).

APP_NAME=warehouse-inventory
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
SQL_ECHO=false

# Подключение приложения к базе данных (формат SQLAlchemy)
DATABASE_URL=postgresql+psycopg2://warehouse:warehouse@localhost:5432/warehouse

# Параметры контейнера PostgreSQL (docker compose)
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse
POSTGRES_DB=warehouse
POSTGRES_PORT=5432
