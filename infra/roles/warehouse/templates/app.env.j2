# {{ ansible_managed }}
# Настройки окружения {{ env_name | default('') }}: хранятся только на сервере (права 600,
# владелец {{ warehouse_owner }}), секреты — из зашифрованного vault.yml.
# Изменения вручную будут отменены следующим запуском Ansible.

REGISTRY_IMAGE={{ warehouse_registry_image }}

AUTH_USERNAME={{ warehouse_auth_username }}
AUTH_PASSWORD={{ warehouse_auth_password }}

POSTGRES_USER={{ warehouse_postgres_user }}
POSTGRES_PASSWORD={{ warehouse_postgres_password }}
POSTGRES_DB={{ warehouse_postgres_db }}

HTTP_BIND={{ warehouse_http_bind }}
HTTP_PORT={{ warehouse_http_port }}
LOG_LEVEL={{ warehouse_log_level }}

AUTO_ROLLBACK={{ warehouse_auto_rollback }}
# 1 — после выпуска полный сценарий с тестовыми записями; 0 — только чтение
VERIFY_SCENARIO={{ 1 if verify_scenario | default(false) | bool else 0 }}
