# Конфигурация сервиса. Реальный файл лежит на сервере приложения по пути
# /etc/warehouse/warehouse.env с правами 640 root:warehouse и в репозиторий
# не попадает. Здесь — только шаблон без секретов.
#
# Формат: KEY=VALUE, без кавычек и без пробелов вокруг «=» (это требование
# systemd EnvironmentFile, а не приложения).

APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
SQL_ECHO=false

# Учётная запись для доступа к API (HTTP Basic)
AUTH_USERNAME=admin
AUTH_PASSWORD=CHANGE_ME

# Подключение к серверу базы данных (машина warehouse-db)
DATABASE_URL=postgresql+psycopg2://warehouse:CHANGE_ME@192.168.56.11:5432/warehouse
