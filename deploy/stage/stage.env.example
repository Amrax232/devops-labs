# Настройки тестового окружения (staging) — хранятся на сервере, отдельно от
# образа: /opt/warehouse-stage/env/stage.env (владелец deploy, права 600).
# Файл создаёт deploy/stage/20-deploy-user.sh со случайными паролями.
# В репозиторий попадает только этот шаблон без настоящих значений.
#
# Все переменные обязательны: deploy.sh не начнёт выпуск, если какая-то
# не задана, и прежняя версия продолжит работать.

# Откуда берётся образ: ghcr.io/<владелец репозитория в нижнем регистре>/warehouse-inventory
REGISTRY_IMAGE=ghcr.io/CHANGE_ME/warehouse-inventory

# Учётная запись API тестового окружения
AUTH_USERNAME=admin
AUTH_PASSWORD=CHANGE_ME

# PostgreSQL тестового окружения (в контейнере, том warehouse-stage_db_data)
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=warehouse

# Nginx слушает только адрес лабораторной сети этой машины
HTTP_BIND=192.168.56.20
HTTP_PORT=8080
LOG_LEVEL=INFO

# 1 — при неудачной проверке после развёртывания вернуть предыдущую версию
AUTO_ROLLBACK=1
